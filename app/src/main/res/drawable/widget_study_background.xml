<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="315"
                android:startColor="@color/widget_bg_surface"
                android:endColor="@color/widget_bg_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_bg_border" />
        </shape>
    </item>

    <item android:gravity="top|start">
        <shape android:shape="oval">
            <size
                android:width="170dp"
                android:height="170dp" />
            <gradient
                android:type="radial"
                android:centerX="35%"
                android:centerY="35%"
                android:gradientRadius="96dp"
                android:startColor="@color/widget_bg_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
